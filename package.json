{
  "name": "my-first-harness",
  "version": "1.0.0",
  "description": "",
  "bin": {
    "my-first-harness": "./dist/my-first-harness.js"
  },
  "files": [
    "dist/*.js",
    "dist/adapters/*.js",
    "dist/tools/*.js",
    "dist/game-testing/**"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node --input-type=module -e \"import { cpSync, mkdirSync } from 'node:fs'; mkdirSync('dist/game-testing', { recursive: true }); cpSync('game-testing/mcp-controller.cjs', 'dist/game-testing/mcp-controller.cjs'); cpSync('game-testing/skills', 'dist/game-testing/skills', { recursive: true });\"",
    "tui": "node my-first-harness.ts --tui",
    "prepack": "pnpm run build",
    "test": "node --test tests/*.test.ts",
    "test:prompts": "node tests/prompt-eval.ts",
    "test:mcp": "node tests/mcp-smoke.ts",
    "test:playwright": "node tests/playwright-smoke.ts",
    "test:game-testing": "node tests/game-testing-smoke.ts",
    "test:responses": "node tests/responses-smoke.ts",
    "test:farm": "node tests/farm-smoke.ts",
    "test:images": "node tests/images-smoke.ts",
    "test:anthropic": "node tests/anthropic-smoke.ts",
    "test:history": "node tests/history-smoke.ts",
    "test:package": "node tests/package-smoke.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.25.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@modelcontextprotocol/server-memory": "^2026.8.31",
    "@playwright/mcp": "0.0.80",
    "ajv": "^8.20.0",
    "dotenv": "^17.4.2",
    "ink": "7.1.1",
    "react": "^19.2.8",
    "react-devtools-core": "^7.0.1",
    "sharp": "0.35.4",
    "string-width": "^8.2.2",
    "wrap-ansi": "^10.0.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "ink-testing-library": "^4.0.0",
    "typescript": "7.0.2"
  }
}
